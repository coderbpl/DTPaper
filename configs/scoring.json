{
  "seed": 42,
  "bootstrap": 500,
  "topk": 10,
  "explain_max_eval": 200,
  "lime_n": 30,
  "data": {
    "source": "text",
    "csv_path": "data/raw/coda.csv",
    "name": "CoDA",
    "text_col": "txt",
    "label_col": "label",
    "test_size": 0.2,
    "min_chars": 10,
    "high_risk": [
      "Arms",
      "Drugs",
      "Weapons",
      "Hacking",
      "Financial",
      "Violence",
      "Crypto"
    ],
    "risk_mode": "severity",
    "binary_threshold": 2,
    "_risk_mode_note": "severity|binary|analyst. For analyst, set analyst_labels_csv to a CSV with key+risk columns.",
    "analyst_labels_csv": ""
  },
  "model": {
    "max_features": 2000
  },
  "paths": {
    "tables": "results/tables",
    "figures": "results/figures",
    "logs": "results/logs",
    "processed": "data/processed"
  },
  "cv_folds": 5,
  "stability_n": 30,
  "stability_perturb": 5,
  "stability_noise": 0.02
}